# Lokalna baza v Dockerju ali Supabase (neposredna povezava za migracije).
DATABASE_URL=postgresql://librarium:librarium@localhost:5432/librarium?schema=librarium

PORT=3001
# Dolg naključen niz, npr. rezultat ukaza: openssl rand -base64 48
JWT_SECRET=zamenjaj-z-dolgim-nakljucnim-nizom
JWT_EXPIRES_IN=1h
# Izvor frontenda, s katerega backend sprejema zahteve (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# Naslov backenda, kot ga vidi brskalnik. Vrednost se vgradi ob gradnji (next build).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Prvi administrator. Seed brez teh dveh vrednosti konča z napako.
ADMIN_EMAIL=admin@librarium.local
ADMIN_PASSWORD=zamenjaj-z-varnim-geslom
# Geslo demo knjižničarke in bralcev iz seeda.
DEMO_PASSWORD=librarium-demo
